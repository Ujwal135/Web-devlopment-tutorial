  <script src="js/script.js"></script>
  <script>
    // Preloader
window.addEventListener('load', () => {
  const preloader = document.getElementById('preloader');
  setTimeout(() => {
    preloader.classList.add('hidden');
  }, 500);
});

// Dark Mode Toggle
const darkModeToggle = document.createElement('div');
darkModeToggle.classList.add('dark-mode-toggle');
darkModeToggle.innerHTML = '<i class="fas fa-moon"></i>';
document.body.appendChild(darkModeToggle);

if (localStorage.getItem('darkMode') === 'enabled') {
  document.body.classList.add('dark-mode');
  darkModeToggle.innerHTML = '<i class="fas fa-sun"></i>';
}

darkModeToggle.addEventListener('click', () => {
  document.body.classList.toggle('dark-mode');
  if (document.body.classList.contains('dark-mode')) {
    darkModeToggle.innerHTML = '<i class="fas fa-sun"></i>';
    localStorage.setItem('darkMode', 'enabled');
  } else {
    darkModeToggle.innerHTML = '<i class="fas fa-moon"></i>';
    localStorage.setItem('darkMode', 'disabled');
  }
});

// Language Content
const langContent = {
  en: {
    navHome: "Home", navAbout: "About", navPortfolio: "Portfolio",
    navTestimonials: "Testimonials", navContact: "Contact",
    heroTitle: "Hi, I'm Alex Johnson", heroSubtitle: "Creative Web Designer & UI/UX Enthusiast",
    btnViewWork: "View My Work", aboutTitle: "About Me",
    aboutText1: "I'm a passionate web designer with over 5 years of experience creating beautiful, user-centered websites.",
    aboutText2: "My expertise includes UI/UX design, responsive layouts, and interactive web solutions using modern tools and best practices.",
    skillsTitle: "My Skills", portfolioTitle: "My Portfolio",
    testimonialsTitle: "What Clients Say", contactTitle: "Get In Touch",
    formName: "Name", formEmail: "Email", formMessage: "Message", formSend: "Send Message",
    footerText: "All Rights Reserved", modalVisit: "Visit Live Site"
  },
  es: {
    navHome: "Inicio", navAbout: "Sobre Mí", navPortfolio: "Portafolio",
    navTestimonials: "Testimonios", navContact: "Contacto",
    heroTitle: "Hola, soy Jane Doe", heroSubtitle: "Diseñadora Web Creativa y Apasionada por UX/UI",
    btnViewWork: "Ver Mi Trabajo", aboutTitle: "Sobre Mí",
    aboutText1: "Soy una diseñadora web apasionada con más de 5 años de experiencia creando sitios web hermosos y centrados en el usuario.",
    aboutText2: "Mi experiencia incluye diseño UX/UI, diseños responsivos y soluciones web interactivas usando herramientas modernas.",
    skillsTitle: "Mis Habilidades", portfolioTitle: "Mi Portafolio",
    testimonialsTitle: "Lo que Dicen los Clientes", contactTitle: "Contáctame",
    formName: "Nombre", formEmail: "Correo", formMessage: "Mensaje", formSend: "Enviar Mensaje",
    footerText: "Todos los Derechos Reservados", modalVisit: "Visitar Sitio"
  }
};

// Language Toggle
const langToggle = document.getElementById('langToggle');
let currentLang = localStorage.getItem('lang') || 'en';

function setLanguage(lang) {
  const t = langContent[lang];
  langToggle.textContent = lang === 'en' ? 'ES' : 'EN';

  document.querySelector('a[href="#home"]').textContent = t.navHome;
  document.querySelector('a[href="#about"]').textContent = t.navAbout;
  document.querySelector('a[href="#portfolio"]').textContent = t.navPortfolio;
  document.querySelector('a[href="#testimonials"]').textContent = t.navTestimonials;
  document.querySelector('a[href="#contact"]').textContent = t.navContact;

  document.querySelector('#home h1').textContent = t.heroTitle;
  document.querySelector('#home .lead').textContent = t.heroSubtitle;
  document.querySelector('#home .btn-lg').textContent = t.btnViewWork;

  document.querySelector('#about h2').textContent = t.aboutTitle;
  const aboutPs = document.querySelectorAll('#about p');
  if (aboutPs[0]) aboutPs[0].textContent = t.aboutText1;
  if (aboutPs[1]) aboutPs[1].textContent = t.aboutText2;

  document.querySelector('#skills h2').textContent = t.skillsTitle;
  document.querySelector('#portfolio h2').textContent = t.portfolioTitle;
  document.querySelector('#testimonials h2').textContent = t.testimonialsTitle;
  document.querySelector('#contact h2').textContent = t.contactTitle;

  document.querySelector('label[for="name"]').textContent = t.formName;
  document.querySelector('label[for="email"]').textContent = t.formEmail;
  document.querySelector('label[for="message"]').textContent = t.formMessage;
  document.getElementById('contactForm').querySelector('button').textContent = t.formSend;

  document.querySelector('footer p').innerHTML = `&copy; 2025 Jane Doe. ${t.footerText}.`;
  document.getElementById('modalLink').textContent = t.modalVisit;

  if (typeof AOS !== 'undefined') AOS.refresh();
}

langToggle.addEventListener('click', () => {
  currentLang = currentLang === 'en' ? 'es' : 'en';
  setLanguage(currentLang);
  localStorage.setItem('lang', currentLang);
});

setLanguage(currentLang);

// Project Modal
const projectModal = document.getElementById('projectModal');
projectModal.addEventListener('show.bs.modal', function (e) {
  const btn = e.relatedTarget;
  document.getElementById('projectModalLabel').textContent = btn.getAttribute('data-title');
  document.getElementById('modalImage').src = btn.getAttribute('data-img');
  document.getElementById('modalDescription').textContent = btn.getAttribute('data-desc');
  document.getElementById('modalLink').href = btn.getAttribute('data-link');
});

// EmailJS Form
document.getElementById('contactForm').addEventListener('submit', function(e) {
  e.preventDefault();
  const name = document.getElementById('name').value;
  const email = document.getElementById('email').value;
  const message = document.getElementById('message').value;

  emailjs.send("YOUR_SERVICE_ID", "YOUR_TEMPLATE_ID", {
    from_name: name,
    from_email: email,
    message: message,
  }).then(() => {
    alert('✅ Thank you! Your message has been sent.');
    this.reset();
  }, (err) => {
    console.error('EmailJS error:', err);
    alert('❌ Failed to send message. Please try again.');
  });
});

// Initialize AOS
document.addEventListener('DOMContentLoaded', () => {
  AOS.init({
    duration: 800,
    easing: 'smooth',
    once: true,
    offset: 100
  });
});
  </script>
  
</body>

